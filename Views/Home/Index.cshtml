@model MahmoudDev.Models.PortfolioViewModel
@{
    ViewData["Title"] = "Full Stack .NET Developer";
}

<!-- =========================================================================
     PAGE 1 — HOME / HERO SECTION
     ========================================================================= -->
<section id="home" class="section hero-section">
    <div class="container">
        <div class="hero-grid">
            <div class="hero-text-content">
                <div class="hero-badge-pill">
                    <span class="hero-badge-dot"></span>
                    <span>Available for Select Client Projects &amp; .NET Roles</span>
                </div>

                <h1 class="hero-title">
                    Hi, I'm <span class="highlight-teal">Mahmoud Abd-Elbakey</span>.<br />
                    Full Stack.NET<span style="font-style: italic; font-family: var(--font-serif); font-weight: 400;"></span> Developer.
                </h1>

                <p class="hero-value-prop">
                    @Model.SubTagline
                </p>

                <div class="hero-brand-philosophy">
                    "I don't just build your idea — I help make it better."
                </div>

                <div class="hero-actions">
                    <a href="#projects" class="btn btn-primary">
                        <span>View My Work</span>
                        <span>↓</span>
                    </a>
                    <a href="#contact" class="btn btn-secondary">
                        <span>Let's Work Together</span>
                        <span>→</span>
                    </a>
                    <button type="button" id="openResumeBtn" class="btn btn-secondary btn-sm" title="View Mahmoud Abd-Elbakey's Professional Resume">
                        <span>📄 View Resume</span>
                    </button>
                </div>

                <div class="hero-tech-strip">
                    <span class="hero-tech-label">Core Stack:</span>
                    <span class="badge badge-teal">C#</span>
                    <span class="badge badge-teal">ASP.NET Core</span>
                    <span class="badge badge-teal">Web API</span>
                    <span class="badge badge-teal">EF Core</span>
                    <span class="badge badge-teal">SQL Server</span>
                    <span class="badge badge-sage">Vanilla JS</span>
                    <span class="badge badge-sage">Docker</span>
                </div>
            </div>

            <!-- Hero Visual / Portrait & Tech Ecosystem — Chips placed OUTSIDE the card -->
            <div class="hero-visual-wrapper">
                <!-- Floating chips positioned relative to wrapper, outside the portrait card -->
                <div class="floating-chip chip-1">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>
                    <span>C# &amp; .NET 10</span>
                </div>
                <div class="floating-chip chip-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                    <span>SQL Server</span>
                </div>
                <div class="floating-chip chip-3">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    <span>REST API</span>
                </div>
                <div class="floating-chip chip-4">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                    <span>ASP.NET Core</span>
                </div>

                <div class="hero-visual-card">
                    <div class="hero-avatar-box hero-avatar-float">
                        <img src="~/images/mahmoud.jpg" alt="Mahmoud Abd-Elbakey — Full Stack .NET Developer" class="hero-avatar-img" />
                    </div>

                    <div style="text-align: center; margin-top: 1.25rem; padding: 0 0.5rem;">
                        <h3 style="font-size: 1.15rem; margin-bottom: 0.15rem; font-weight: 800; letter-spacing: -0.02em;">Mahmoud Abd-Elbakey</h3>
                        <p style="font-size: 0.8125rem; color: var(--text-muted); margin: 0;">Full Stack .NET Developer &amp; Idea Partner</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 2 — ABOUT ME SECTION
     ========================================================================= -->
<section id="about" class="section section-alt">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">About Mahmoud Abd-Elbakey</span>
            <h2 class="section-title">The Mindset Behind the Code</h2>
            <p class="section-description">
                Software development is more than syntax and frameworks. It is about understanding the human and business problem, asking the right questions, and turning concepts into resilient digital reality.
            </p>
        </div>

        <div class="about-quote-box" style="display: flex; align-items: center; justify-content: center; gap: 2rem; flex-wrap: wrap; text-align: left;">
            <img src="~/images/mahmoud.jpg" alt="Mahmoud" style="width: 95px; height: 95px; border-radius: 50%; object-fit: cover; object-position: center 15%; border: 3px solid var(--teal-primary); box-shadow: var(--shadow-md); flex-shrink: 0;" />
            <div style="max-width: 720px;">
                <div class="about-quote-text" style="font-size: clamp(1.2rem, 2.2vw, 1.6rem); margin-bottom: 0.5rem;">
                    "I don't just build what the client asks for. I take the time to understand the idea, uncover what's truly needed, and help make it better."
                </div>
                <div class="about-quote-author">
                    — Mahmoud | Full Stack .NET Developer
                </div>
            </div>
        </div>

        <div class="grid-4">
            <div class="pillar-card">
                <div class="pillar-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <h3 class="pillar-title">Continuous Growth</h3>
                <p class="pillar-text">
                    With approximately 2 years of professional development and a deep background in computer science, I approach every project with relentless curiosity, always staying at the cutting edge of modern .NET.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </div>
                <h3 class="pillar-title">Creative Thinking</h3>
                <p class="pillar-text">
                    I believe business systems should never be clumsy or painful to use. I bring creative UX intuition and smart architectural suggestions to every client specification.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                </div>
                <h3 class="pillar-title">Technical Rigor</h3>
                <p class="pillar-text">
                    Deep mastery of C#, ASP.NET Core, EF Core, and SQL Server ensures that applications are secure, maintainable, testable, and built on sound design patterns (SOLID &amp; Clean Architecture).
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <h3 class="pillar-title">Root Problem Solving</h3>
                <p class="pillar-text">
                    I don't mask bugs with superficial patches. I locate the actual operational bottleneck — whether an unindexed table, a race condition, or a confusing user flow — and fix it at the foundation.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 3 — EDUCATION & LEARNING MILESTONES
     ========================================================================= -->
<section id="education" class="section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Academic Foundations</span>
            <h2 class="section-title">Education &amp; Growth Story</h2>
            <p class="section-description">
                A rigorous academic education combined with specialized professional training provided the bedrock for my engineering discipline and problem-solving instincts.
            </p>
        </div>

        <div class="grid-3">
            @foreach (var edu in Model.EducationItems)
            {
                <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                            <span class="badge badge-teal">@edu.Period</span>
                            <span class="badge badge-sage">Verified Track</span>
                        </div>

                        <h3 style="font-size: 1.15rem; margin-bottom: 0.35rem; font-weight: 700;">@edu.Degree</h3>
                        <div style="font-size: 0.875rem; font-weight: 600; color: var(--teal-primary); margin-bottom: 0.85rem;">@edu.Institution</div>

                        <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 1rem;">
                            @edu.Description
                        </p>

                        <div style="margin-bottom: 1rem; padding-top: 0.75rem; border-top: 1px solid rgba(0,0,0,0.06);">
                            <strong style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--teal-primary); display: block; margin-bottom: 0.4rem;">Key Milestones:</strong>
                            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.825rem; color: var(--text-secondary);">
                                @foreach (var milestone in edu.KeyMilestones)
                                {
                                    <li style="display: flex; align-items: flex-start; gap: 0.4rem;">
                                        <span style="color: var(--teal-primary); font-weight: bold;">✓</span>
                                        <span>@milestone</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid rgba(0,0,0,0.06);">
                        @foreach (var topic in edu.RelevantTopics)
                        {
                            <span class="badge" style="font-size: 0.7rem;">@topic</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 4 — SKILLS MATRIX (NO BORING PERCENTAGE BARS)
     ========================================================================= -->
<section id="skills" class="section section-alt">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Technical Competencies</span>
            <h2 class="section-title">Skills &amp; Architectural Toolkit</h2>
            <p class="section-description">
                Organized by practical domain with real-world application context. No arbitrary percentage bars — only demonstrable engineering capabilities.
            </p>
        </div>

        <!-- Filter Tabs -->
        <div class="skills-nav-tabs">
            <button type="button" class="skill-tab-btn active" data-category="all">All Skills</button>
            @foreach (var group in Model.SkillGroups)
            {
                <button type="button" class="skill-tab-btn" data-category="@group.Category">@group.Category</button>
            }
        </div>

        <!-- Skill Groups -->
        @foreach (var group in Model.SkillGroups)
        {
            <div class="skill-category-block" data-category="@group.Category">
                <div class="skill-category-header">
                    <div>
                        <h3 class="skill-category-title">@group.Title</h3>
                        <p style="font-size: 0.9rem; color: var(--text-muted); margin: 0;">@group.Description</p>
                    </div>
                </div>

                <div class="grid-3">
                    @foreach (var skill in group.Skills)
                    {
                        <div class="skill-card">
                            <div>
                                <div class="skill-card-top">
                                    <span class="skill-name">@skill.Name</span>
                                    @if (skill.IsPrimary)
                                    {
                                        <span class="badge badge-teal">Core</span>
                                    }
                                    else
                                    {
                                        <span class="badge">Proficient</span>
                                    }
                                </div>
                                <p class="skill-card-context">@skill.Context</p>
                            </div>
                            <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid rgba(0,0,0,0.05); font-size: 0.75rem; color: var(--teal-primary); font-weight: 600;">
                                Verified in Production &amp; Projects
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- =========================================================================
     PAGE 5 — WORK EXPERIENCE
     ========================================================================= -->
<section id="experience" class="section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Professional History</span>
            <h2 class="section-title">Work Experience &amp; Impact</h2>
            <p class="section-description">
                Demonstrated business outcomes, engineering contributions, and reliable execution in commercial and client-facing environments.
            </p>
        </div>

        <div class="grid-2">
            @foreach (var exp in Model.Experiences)
            {
                <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                            <div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.2rem;">@exp.Role</h3>
                                <div style="font-size: 0.9rem; font-weight: 600; color: var(--teal-primary);">@exp.Organization • <span style="font-weight: normal; color: var(--text-muted);">@exp.Location</span></div>
                            </div>
                            <span class="badge badge-teal">@exp.Period</span>
                        </div>

                        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 1.25rem;">
                            @exp.Summary
                        </p>

                        <div style="margin-bottom: 1.25rem;">
                            <strong style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--teal-primary); display: block; margin-bottom: 0.4rem;">Core Responsibilities &amp; Delivery:</strong>
                            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem; color: var(--text-secondary);">
                                @foreach (var resp in exp.Responsibilities)
                                {
                                    <li style="display: flex; align-items: flex-start; gap: 0.4rem;">
                                        <span style="color: var(--teal-primary); font-weight: bold;">→</span>
                                        <span>@resp</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div style="background-color: var(--teal-light); border-left: 3px solid var(--teal-primary); padding: 0.85rem 1rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin-bottom: 1.25rem;">
                            <strong style="font-size: 0.75rem; text-transform: uppercase; color: var(--teal-primary); display: block; margin-bottom: 0.35rem;">Measurable Outcomes:</strong>
                            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.3rem;">
                                @foreach (var result in exp.Results)
                                {
                                    <li style="font-size: 0.825rem; color: var(--text-primary);">✓ @result</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; padding-top: 0.75rem; border-top: 1px solid rgba(0,0,0,0.06);">
                        @foreach (var tech in exp.Technologies)
                        {
                            <span class="badge badge-teal" style="font-size: 0.725rem;">@tech</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 6 — CAREER JOURNEY (PROGRESSIVE STORYTELLING)
     ========================================================================= -->
<section id="journey" class="section section-alt">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Career Evolution</span>
            <h2 class="section-title">The Journey of Growth</h2>
            <p class="section-description">
                From a curious student writing terminal scripts to an idea-driven Full Stack .NET Developer crafting high-value digital solutions.
            </p>
        </div>

        <div class="grid-3">
            @foreach (var stage in Model.JourneyStages)
            {
                <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 1.5rem;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; gap: 0.5rem; flex-wrap: wrap;">
                            <span class="badge badge-teal" style="font-weight: 800;">Stage 0@stage.Step</span>
                            <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">@stage.Timeframe</span>
                        </div>

                        <h3 style="font-size: 1.15rem; margin-bottom: 0.2rem; font-weight: 700;">@stage.StageTitle</h3>
                        <div style="font-size: 0.8rem; font-weight: 600; color: var(--teal-primary); margin-bottom: 0.75rem;">@stage.Subtitle</div>

                        <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 0.85rem;">
                            @stage.Story
                        </p>

                        <div style="margin-bottom: 0.85rem; padding-top: 0.6rem; border-top: 1px solid rgba(0,0,0,0.06);">
                            <strong style="font-size: 0.725rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); display: block; margin-bottom: 0.35rem;">Milestones:</strong>
                            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.8rem; color: var(--text-secondary);">
                                @foreach (var m in stage.Milestones)
                                {
                                    <li style="display: flex; align-items: flex-start; gap: 0.35rem;">
                                        <span style="color: var(--teal-primary); font-weight: bold;">•</span>
                                        <span>@m</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div style="background-color: var(--bg-secondary); border-left: 3px solid var(--teal-primary); padding: 0.6rem 0.8rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 0.775rem; font-weight: 600; color: var(--text-primary); margin-top: 0.5rem;">
                        @stage.ImpactSummary
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 7 — WHY WORK WITH ME? (6 CORE PILLARS)
     ========================================================================= -->
<section id="whyme" class="section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">The Client Advantage</span>
            <h2 class="section-title">"I Don't Just Implement Ideas — I Help Improve Them"</h2>
            <p class="section-description">
                Software development is not about blindly writing code. It is about understanding the root challenge, questioning assumptions, and engineering an optimal, resilient digital solution.
            </p>
        </div>

        <!-- The 4-Step Idea Elevation Framework -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2.5rem;">
            <div class="card" style="padding: 1.25rem; text-align: center; border-top: 3px solid var(--teal-primary);">
                <div style="font-size: 0.75rem; font-weight: 800; color: var(--teal-primary); text-transform: uppercase; margin-bottom: 0.25rem;">01. The Problem</div>
                <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.35rem;">Root Diagnosis</div>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; line-height: 1.45;">Uncovering underlying operational bottlenecks beyond superficial symptoms.</p>
            </div>
            <div class="card" style="padding: 1.25rem; text-align: center; border-top: 3px solid var(--teal-primary);">
                <div style="font-size: 0.75rem; font-weight: 800; color: var(--teal-primary); text-transform: uppercase; margin-bottom: 0.25rem;">02. The Goal</div>
                <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.35rem;">Business Value</div>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; line-height: 1.45;">Aligning software architecture with business efficiency, revenue, and growth.</p>
            </div>
            <div class="card" style="padding: 1.25rem; text-align: center; border-top: 3px solid var(--teal-primary);">
                <div style="font-size: 0.75rem; font-weight: 800; color: var(--teal-primary); text-transform: uppercase; margin-bottom: 0.25rem;">03. The Users</div>
                <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.35rem;">Human Flow</div>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; line-height: 1.45;">Engineering clean, frictionless workflows that people genuinely love using.</p>
            </div>
            <div class="card" style="padding: 1.25rem; text-align: center; border-top: 3px solid var(--teal-primary);">
                <div style="font-size: 0.75rem; font-weight: 800; color: var(--teal-primary); text-transform: uppercase; margin-bottom: 0.25rem;">04. The Solution</div>
                <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.35rem;">Scalable System</div>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; line-height: 1.45;">Guaranteeing data integrity, speed, security, and effortless maintainability.</p>
            </div>
        </div>

        <div class="grid-3">
            @foreach (var item in Model.WhyMeReasons)
            {
                <div class="whyme-card" style="padding: 1.75rem;">
                    <div class="whyme-header" style="margin-bottom: 0.75rem;">
                        <span class="whyme-pillar-tag">@item.Pillar</span>
                        <h3 class="whyme-title" style="font-size: 1.15rem;">@item.Headline</h3>
                    </div>

                    <div class="whyme-contrast-block" style="margin: 0.75rem 0; gap: 0.5rem;">
                        <div class="whyme-contrast-item problem" style="padding: 0.6rem 0.75rem; font-size: 0.825rem;">
                            <strong style="display: block; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.15rem;">Typical Approach:</strong>
                            @item.ClientPerspective
                        </div>
                        <div class="whyme-contrast-item approach" style="padding: 0.6rem 0.75rem; font-size: 0.825rem;">
                            <strong style="display: block; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.15rem;">Mahmoud's Approach:</strong>
                            @item.MahmoudApproach
                        </div>
                    </div>

                    <div class="whyme-impact" style="font-size: 0.8rem;">
                        <strong style="color: var(--teal-primary);">The Result:</strong> @item.BusinessImpact
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 8 — OFFERED SERVICES
     ========================================================================= -->
<section id="services" class="section section-alt">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Engineering Offerings</span>
            <h2 class="section-title">Services Built for Business Impact</h2>
            <p class="section-description">
                Tailored web engineering services focused on tangible client value, operational speed, and reliable .NET technical foundations.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
            @foreach (var service in Model.Services)
            {
                <div class="service-card" style="padding: 1.75rem;">
                    <div>
                        <div class="service-top-tag">@service.CategoryTag</div>
                        <h3 class="service-title" style="font-size: 1.2rem; margin-bottom: 0.75rem;">@service.Title</h3>
                        
                        <div class="service-benefit-box" style="padding: 0.65rem 0.85rem; margin-bottom: 1rem;">
                            <div class="service-benefit-title" style="font-size: 0.7rem;">Client Benefit:</div>
                            <p class="service-benefit-text" style="font-size: 0.825rem;">@service.ClientBenefit</p>
                        </div>

                        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
                            @service.Description
                        </p>

                        <ul class="service-deliverables" style="gap: 0.3rem; margin-bottom: 1.25rem;">
                            @foreach (var d in service.Deliverables)
                            {
                                <li style="font-size: 0.825rem;">@d</li>
                            }
                        </ul>
                    </div>

                    <div>
                        <div class="service-tags" style="gap: 0.35rem; padding-top: 0.75rem;">
                            @foreach (var t in service.TechStack)
                            {
                                <span class="badge" style="font-size: 0.7rem;">@t</span>
                            }
                        </div>
                        <a href="#contact" class="btn btn-secondary btn-sm" style="width: 100%; margin-top: 0.85rem; text-align: center;">
                            Inquire About This Service
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     PAGE 9 & 10 — PROJECTS & CASE STUDIES SHOWCASE
