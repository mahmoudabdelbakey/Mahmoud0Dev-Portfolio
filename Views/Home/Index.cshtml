<section id="projects" class="section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Flagship Work</span>
            <h2 class="section-title">Projects &amp; In-Depth Case Studies</h2>
            <p class="section-description">
                Explore real applications engineered with .NET, SQL Server, and modern architecture. Click "View Case Study" to see the full problem-to-result walkthrough.
            </p>
        </div>

        <!-- Category Filters -->
        <div class="skills-nav-tabs" style="margin-bottom: 3rem;">
            <button type="button" class="skill-tab-btn project-filter-btn active" data-filter="all">All Projects</button>
            <button type="button" class="skill-tab-btn project-filter-btn" data-filter="Enterprise Web App">Enterprise Web App</button>
            <button type="button" class="skill-tab-btn project-filter-btn" data-filter="Healthcare System">Healthcare</button>
            <button type="button" class="skill-tab-btn project-filter-btn" data-filter="E-Commerce">E-Commerce</button>
            <button type="button" class="skill-tab-btn project-filter-btn" data-filter="Productivity SaaS">Productivity</button>
        </div>

        <div class="grid-2">
            @foreach (var project in Model.Projects)
            {
                <div class="project-card" data-category="@project.Category">
                    <div class="project-mockup-header">
                        <span class="project-mockup-badge">@project.Category</span>
                        <img src="~/images/project-@(project.Id).svg" alt="@project.Title Mockup" class="project-mockup-svg" />
                    </div>

                    <div class="project-card-body">
                        <div>
                            <h3 class="project-title">@project.Title</h3>
                            <div class="project-subtitle">@project.Subtitle</div>
                            
                            <div class="project-value-box">
                                <strong>Value Created:</strong> @project.ValueProposition
                            </div>

                            <p style="font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
                                @project.Description
                            </p>

                            <div style="margin-bottom: 1.25rem;">
                                <strong style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 0.4rem;">Key Highlights:</strong>
                                <ul style="list-style: none; padding: 0; font-size: 0.875rem; display: flex; flex-direction: column; gap: 0.3rem;">
                                    @foreach (var feature in project.MainFeatures.Take(3))
                                    {
                                        <li style="display: flex; align-items: center; gap: 0.5rem;">
                                            <span style="color: var(--teal-primary); font-weight: bold;">✓</span>
                                            <span>@feature</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div>
                            <div class="project-tags">
                                @foreach (var tech in project.Technologies)
                                {
                                    <span class="badge badge-teal">@tech</span>
                                }
                            </div>

                            <div class="project-card-actions">
                                @if (project.HasCaseStudy && project.CaseStudy != null)
                                {
                                    <button type="button" class="btn btn-primary btn-sm view-casestudy-btn" data-id="@project.CaseStudy.Id">
                                        View Case Study (Modal)
                                    </button>
                                    <a href="/case-study/@project.CaseStudy.Id" class="btn btn-secondary btn-sm" target="_blank">
                                        Dedicated Page ↗
                                    </a>
                                }
                                else
                                {
                                    <a href="#contact" class="btn btn-secondary btn-sm">
                                        Request Walkthrough
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

