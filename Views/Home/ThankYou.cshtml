@{
    ViewData["Title"] = "Thank You";
}

<div class="thankyou-wrapper">
    <div class="thankyou-card">
        <div class="thankyou-check-icon">✓</div>
        <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Message Received!</h1>
        <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.75rem;">
            Thank you for reaching out. Mahmoud has received your project details and will review your idea, prepare initial thoughts, and get back to you within 24 hours.
        </p>

        <div style="background-color: var(--teal-light); border: 1px solid var(--teal-border); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 2rem; text-align: left;">
            <div style="font-weight: 700; color: var(--teal-primary); margin-bottom: 0.25rem;">What happens next?</div>
            <p style="font-size: 0.9rem; color: var(--text-primary); margin: 0; line-height: 1.5;">
                Mahmoud will examine your project requirements, identify potential architectural opportunities or UX enhancements, and schedule a brief discovery call to explore the best way forward.
            </p>
        </div>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
            <a href="/" class="btn btn-primary">← Back to Portfolio</a>
            <a href="https://linkedin.com" target="_blank" class="btn btn-secondary">Connect on LinkedIn</a>
        </div>
    </div>
</div>
